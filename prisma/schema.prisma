generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id(map: "User_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      AuditLog[]
}

enum Role {
  ADMIN
  STAFF
}

model Client {
  id                     String   @id(map: "Client_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String
  nid                    String?
  phone                  String?
  email                  String?
  encryptedEmailPassword String?
  isActive               Boolean  @default(true)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organizations   Organization[]
  serviceProfiles ServiceProfile[]
}

model Organization {
  id              String   @id(map: "Organization_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientId        String   @db.Uuid
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "Organization_new_clientId_fkey")
  name            String
  address         String?
  tradeLicenseNo  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceProfiles ServiceProfile[]
}

model Category {
  id        String   @id(map: "Category_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String   @unique // e.g., "VAT", "eReturn", "IRC", "ERC", "Trade License"
  frequency String   // e.g., "Monthly", "Yearly"
  portalUrl String?  // Portal login URL for services in this category
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceProfiles ServiceProfile[]
}

model ServiceProfile {
  id                           String   @id(map: "ServiceProfile_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientId                     String?  @db.Uuid
  client                       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "ServiceProfile_new_clientId_fkey")
  organizationId               String?  @db.Uuid
  organization                 Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "ServiceProfile_new_organizationId_fkey")
  categoryId                   String   @db.Uuid
  category                     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "ServiceProfile_new_categoryId_fkey")
  
  portalUserId                 String?
  portalEncryptedPassword      String?
  portalEmail                  String?
  portalEncryptedEmailPassword String?
  
  miscellaneousData            Json?    // Any extra columns like specific IDs or notes

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  servicePeriods               ServicePeriod[]
}

model ServicePeriod {
  id               String   @id(map: "ServicePeriod_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serviceProfileId String   @db.Uuid
  serviceProfile   ServiceProfile @relation(fields: [serviceProfileId], references: [id], onDelete: Cascade, map: "ServicePeriod_new_serviceProfileId_fkey")
  
  period           String   // e.g., "2023-10" or "2023-2024"
  paymentAmount    Float?   @default(0)
  isPaid           Boolean  @default(false)
  serviceCharge    Float?   @default(0)
  status           String?  // e.g., "Pending", "Submitted", "Completed"
  
  periodData       Json?    // e.g., { "NeedPrint": "Yes", "VatStatus": "VAT", "TaxPaidAmount": 5000 }

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TaxFiscalYear {
  id                           String    @id @default(uuid())
  year                         String    @unique
  label                        String
  description                  String?
  isActive                     Boolean   @default(true)
  strategy                     Json?
  femaleSeniorThreshold        Float?
  thirdGenderDisabledThreshold Float?
  freedomJulyFighterThreshold  Float?
  disabledChildAllowance       Float?    @default(50000)
  minTaxStandard               Float?    @default(5000)
  minTaxNewTaxpayer            Float?    @default(1000)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  slabs                        TaxSlab[]
}

model TaxSlab {
  id            String        @id @default(uuid())
  fiscalYearId  String
  fiscalYear    TaxFiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  sequence      Int
  limitAmount   Float?
  rate          Float
  label         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([fiscalYearId, sequence])
  @@index([fiscalYearId])
}

model AuditLog {
  id        String   @id(map: "AuditLog_new_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, map: "AuditLog_new_userId_fkey")
  action    String   // e.g., "CREATE", "UPDATE", "DELETE"
  entity    String   // e.g., "Client", "ServicePeriod"
  entityId  String
  details   Json?    // e.g., { "previousStatus": "Pending", "newStatus": "Submitted" }
  createdAt DateTime @default(now())
}
